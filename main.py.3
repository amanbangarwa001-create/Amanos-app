<body>from kivy.app import App<br/>from kivy.lang import Builder<br/>from kivy.properties import StringProperty, NumericProperty, BooleanProperty<br/>from kivy.uix.screenmanager import ScreenManager, Screen<br/>from kivy.clock import Clock<br/>from datetime import datetime<br/><br/>KV = r&quot;&quot;&quot;<br/>#:import dp kivy.metrics.dp<br/>&lt;MainButton@Button&gt;:<br/>    background_normal: &#39;&#39;<br/>    background_color: app.card_color<br/>    color: app.text_color<br/>    font_size: dp(13)<br/>    bold: True<br/>    size_hint_y: None<br/>    height: dp(48)<br/><br/>&lt;LockScreen&gt;:<br/>    BoxLayout:<br/>        orientation: &#39;vertical&#39;<br/>        padding: dp(28)<br/>        spacing: dp(12)<br/>        Label:<br/>            text: &#39;AMANOS&#39;<br/>            color: app.blue_color<br/>            font_size: dp(18)<br/>            bold: True<br/>        Label:<br/>            text: root.time_text<br/>            color: app.text_color<br/>            font_size: dp(42)<br/>            bold: True<br/>        Label:<br/>            text: root.date_text<br/>            color: app.gray_color<br/>        Widget:<br/>        Label:<br/>            text: &#39;FACE ID&#39;<br/>            color: app.text_color<br/>            font_size: dp(22)<br/>            bold: True<br/>        MainButton:<br/>            text: root.face_status<br/>            background_color: app.blue_color<br/>            on_release: root.start_face()<br/>        MainButton:<br/>            text: &#39;USE PIN&#39;<br/>            on_release: root.manager.current = &#39;pin&#39;<br/>        Widget:<br/>        Label:<br/>            text: &#39;SECURE BY AMANOS&#39;<br/>            color: app.green_color<br/>        Label:<br/>            text: &#39;AMANOS OS 3.3 • Android Prototype&#39;<br/>            color: app.gray_color<br/><br/>&lt;PinScreen&gt;:<br/>    BoxLayout:<br/>        orientation: &#39;vertical&#39;<br/>        padding: dp(35)<br/>        spacing: dp(12)<br/>        Label:<br/>            text: &#39;ENTER PIN&#39;<br/>            color: app.text_color<br/>            font_size: dp(22)<br/>            bold: True<br/>        Label:<br/>            text: &#39;Enter 4-digit PIN&#39;<br/>            color: app.gray_color<br/>        TextInput:<br/>            id: pin<br/>            password: True<br/>            input_filter: &#39;int&#39;<br/>            multiline: False<br/>            halign: &#39;center&#39;<br/>            font_size: dp(24)<br/>            size_hint_y: None<br/>            height: dp(55)<br/>            background_normal: &#39;&#39;<br/>            background_color: app.card_color<br/>            foreground_color: app.text_color<br/>        Label:<br/>            text: root.message<br/>            color: app.green_color if root.ok else app.red_color<br/>        MainButton:<br/>            text: &#39;UNLOCK&#39;<br/>            background_color: app.blue_color<br/>            on_release: root.unlock(pin.text)<br/>        MainButton:<br/>            text: &#39;BACK&#39;<br/>            on_release: root.manager.current = &#39;lock&#39;<br/><br/>&lt;HomeScreen&gt;:<br/>    BoxLayout:<br/>        orientation: &#39;vertical&#39;<br/>        padding: dp(14)<br/>        spacing: dp(8)<br/>        BoxLayout:<br/>            size_hint_y: None<br/>            height: dp(28)<br/>            Label:<br/>                text: root.time_text<br/>                color: app.text_color<br/>                bold: True<br/>            Label:<br/>                text: &#39;78%&#39;<br/>                color: app.green_color<br/>        Label:<br/>            text: &#39;AMANOS&#39;<br/>            color: app.text_color<br/>            font_size: dp(28)<br/>            bold: True<br/>        Label:<br/>            text: &#39;Clean. Fast. Personal.&#39;<br/>            color: app.gray_color<br/>        GridLayout:<br/>            cols: 2<br/>            spacing: dp(6)<br/>            MainButton:<br/>                text: &#39;PHONE&#39;<br/>                on_release: root.info(&#39;PHONE&#39;, &#39;Ready\nCalls: No active call\nContacts: Available&#39;)<br/>            MainButton:<br/>                text: &#39;GAMING&#39;<br/>                on_release: root.manager.current = &#39;gaming&#39;<br/>            MainButton:<br/>                text: &#39;BATTERY&#39;<br/>                on_release: root.info(&#39;BATTERY&#39;, &#39;78%\nStatus: Normal\nPower Mode: Balanced&#39;)<br/>            MainButton:<br/>                text: &#39;SETTINGS&#39;<br/>                on_release: root.manager.current = &#39;settings&#39;<br/>            MainButton:<br/>                text: &#39;PANEL&#39;<br/>                on_release: root.manager.current = &#39;panel&#39;<br/>            MainButton:<br/>                text: &#39;SECURITY&#39;<br/>                on_release: root.info(&#39;SECURITY&#39;, &#39;Face ID: Protected\nPIN: Enabled\nDevice: Secure&#39;)<br/>            MainButton:<br/>                text: &#39;MUSIC&#39;<br/>                on_release: root.info(&#39;MUSIC&#39;, &#39;No track selected\nPlayer: Ready&#39;)<br/>            MainButton:<br/>                text: &#39;FILES&#39;<br/>                on_release: root.info(&#39;FILES&#39;, &#39;Demo storage\nNo recent files&#39;)<br/>            MainButton:<br/>                text: &#39;CAMERA&#39;<br/>                on_release: root.info(&#39;CAMERA&#39;, &#39;Preview simulation\nPhoto mode&#39;)<br/>            MainButton:<br/>                text: &#39;ABOUT&#39;<br/>                on_release: root.info(&#39;ABOUT&#39;, &#39;AmanOS Version 3.3\nAndroid/Kivy prototype&#39;)<br/>        MainButton:<br/>            text: &#39;APP DRAWER&#39;<br/>            on_release: root.manager.current = &#39;drawer&#39;<br/>        Label:<br/>            text: &#39;AMANOS READY&#39;<br/>            color: app.green_color<br/>        MainButton:<br/>            text: &#39;LOCK&#39;<br/>            on_release: root.manager.current = &#39;lock&#39;<br/><br/>&lt;DrawerScreen&gt;:<br/>    BoxLayout:<br/>        orientation: &#39;vertical&#39;<br/>        padding: dp(18)<br/>        spacing: dp(8)<br/>        Label:<br/>            text: &#39;APP DRAWER&#39;<br/>            color: app.text_color<br/>            font_size: dp(22)<br/>            bold: True<br/>        TextInput:<br/>            hint_text: &#39;Search apps&#39;<br/>            multiline: False<br/>            size_hint_y: None<br/>            height: dp(48)<br/>            background_normal: &#39;&#39;<br/>            background_color: app.card_color<br/>            foreground_color: app.text_color<br/>        GridLayout:<br/>            cols: 2<br/>            spacing: dp(6)<br/>            MainButton:<br/>                text: &#39;PHONE&#39;<br/>                on_release: root.manager.current = &#39;home&#39;<br/>            MainButton:<br/>                text: &#39;GAMING&#39;<br/>                on_release: root.manager.current = &#39;gaming&#39;<br/>            MainButton:<br/>                text: &#39;BATTERY&#39;<br/>                on_release: root.manager.current = &#39;home&#39;<br/>            MainButton:<br/>                text: &#39;SETTINGS&#39;<br/>                on_release: root.manager.current = &#39;settings&#39;<br/>            MainButton:<br/>                text: &#39;PANEL&#39;<br/>                on_release: root.manager.current = &#39;panel&#39;<br/>            MainButton:<br/>                text: &#39;NOTIFICATIONS&#39;<br/>                on_release: root.manager.current = &#39;notifications&#39;<br/>            MainButton:<br/>                text: &#39;ABOUT&#39;<br/>                on_release: root.manager.current = &#39;about&#39;<br/>        MainButton:<br/>            text: &#39;BACK&#39;<br/>            on_release: root.manager.current = &#39;home&#39;<br/><br/>&lt;GamingScreen&gt;:<br/>    BoxLayout:<br/>        orientation: &#39;vertical&#39;<br/>        padding: dp(28)<br/>        spacing: dp(10)<br/>        Label:<br/>            text: &#39;AMANOS GAME BOOSTER&#39;<br/>            color: app.blue_color<br/>            font_size: dp(22)<br/>            bold: True<br/>        Label:<br/>            text: &#39;FPS&#39;<br/>            color: app.gray_color<br/>        Label:<br/>            text: str(root.fps)<br/>            color: app.green_color<br/>            font_size: dp(55)<br/>            bold: True<br/>        Label:<br/>            text: root.mode + &#39; mode&#39;<br/>            color: app.gray_color<br/>        MainButton:<br/>            text: &#39;BALANCED 60 FPS&#39;<br/>            on_release: root.set_mode(&#39;Balanced&#39;, 60)<br/>        MainButton:<br/>            text: &#39;PERFORMANCE 90 FPS&#39;<br/>            background_color: app.blue_color<br/>            on_release: root.set_mode(&#39;Performance&#39;, 90)<br/>        MainButton:<br/>            text: &#39;EXTREME 120 FPS&#39;<br/>            on_release: root.set_mode(&#39;Extreme&#39;, 120)<br/>        Label:<br/>            text: &#39;Touch Response: High&#39;<br/>            color: app.gray_color<br/>        MainButton:<br/>            text: &#39;BACK&#39;<br/>            on_release: root.manager.current = &#39;home&#39;<br/><br/>&lt;PanelScreen&gt;:<br/>    BoxLayout:<br/>        orientation: &#39;vertical&#39;<br/>        padding: dp(20)<br/>        spacing: dp(8)<br/>        Label:<br/>            text: &#39;CONTROL PANEL&#39;<br/>            color: app.text_color<br/>            font_size: dp(22)<br/>            bold: True<br/>        GridLayout:<br/>            cols: 2<br/>            spacing: dp(6)<br/>            MainButton:<br/>                text: root.wifi_text<br/>                on_release: root.toggle(&#39;wifi&#39;)<br/>            MainButton:<br/>                text: root.bt_text<br/>                on_release: root.toggle(&#39;bt&#39;)<br/>            MainButton:<br/>                text: root.air_text<br/>                on_release: root.toggle(&#39;air&#39;)<br/>            MainButton:<br/>                text: root.dnd_text<br/>                on_release: root.toggle(&#39;dnd&#39;)<br/>        Label:<br/>            text: &#39;Brightness: &#39; + str(root.brightness) + &#39;%&#39;<br/>            color: app.gray_color<br/>        Slider:<br/>            min: 0<br/>            max: 100<br/>            value: root.brightness<br/>            on_value: root.brightness = int(self.value)<br/>        Label:<br/>            text: &#39;Volume: &#39; + str(root.volume) + &#39;%&#39;<br/>            color: app.gray_color<br/>        Slider:<br/>            min: 0<br/>            max: 100<br/>            value: root.volume<br/>            on_value: root.volume = int(self.value)<br/>        Label:<br/>            text: &#39;UI simulation only&#39;<br/>            color: app.gray_color<br/>        MainButton:<br/>            text: &#39;BACK&#39;<br/>            on_release: root.manager.current = &#39;home&#39;<br/><br/>&lt;SettingsScreen&gt;:<br/>    BoxLayout:<br/>        orientation: &#39;vertical&#39;<br/>        padding: dp(20)<br/>        spacing: dp(8)<br/>        Label:<br/>            text: &#39;SETTINGS&#39;<br/>            color: app.text_color<br/>            font_size: dp(24)<br/>            bold: True<br/>        MainButton:<br/>            text: &#39;DARK THEME&#39;<br/>            on_release: app.set_theme(False)<br/>        MainButton:<br/>            text: &#39;LIGHT THEME&#39;<br/>            on_release: app.set_theme(True)<br/>        MainButton:<br/>            text: &#39;GAMING&#39;<br/>            on_release: root.manager.current = &#39;gaming&#39;<br/>        MainButton:<br/>            text: &#39;ABOUT AMANOS&#39;<br/>            on_release: root.manager.current = &#39;about&#39;<br/>        MainButton:<br/>            text: &#39;BACK&#39;<br/>            on_release: root.manager.current = &#39;home&#39;<br/><br/>&lt;InfoScreen&gt;:<br/>    BoxLayout:<br/>        orientation: &#39;vertical&#39;<br/>        padding: dp(28)<br/>        spacing: dp(12)<br/>        Label:<br/>            text: root.title_text<br/>            color: app.text_color<br/>            font_size: dp(24)<br/>            bold: True<br/>        Label:<br/>            text: root.body_text<br/>            color: app.gray_color<br/>            font_size: dp(16)<br/>        MainButton:<br/>            text: &#39;BACK&#39;<br/>            on_release: root.manager.current = &#39;home&#39;<br/><br/>&lt;NotificationsScreen&gt;:<br/>    BoxLayout:<br/>        orientation: &#39;vertical&#39;<br/>        padding: dp(20)<br/>        spacing: dp(12)<br/>        Label:<br/>            text: &#39;NOTIFICATIONS&#39;<br/>            color: app.text_color<br/>            font_size: dp(22)<br/>            bold: True<br/>        Label:<br/>            text: &#39;AmanOS is ready\nGaming Mode available&#39;<br/>            color: app.gray_color<br/>            font_size: dp(16)<br/>        MainButton:<br/>            text: &#39;BACK&#39;<br/>            on_release: root.manager.current = &#39;home&#39;<br/>&quot;&quot;&quot;<br/><br/>class Root(ScreenManager):<br/>    pass<br/><br/>class LockScreen(Screen):<br/>    time_text = StringProperty(&quot;&quot;)<br/>    date_text = StringProperty(&quot;&quot;)<br/>    face_status = StringProperty(&quot;START FACE SCAN&quot;)<br/>    def on_enter(self):<br/>        self.update_clock()<br/>    def update_clock(self, *args):<br/>        now = datetime.now()<br/>        self.time_text = now.strftime(&quot;%H:%M&quot;)<br/>        self.date_text = now.strftime(&quot;%A, %d %B&quot;)<br/>        Clock.schedule_once(self.update_clock, 1)<br/>    def start_face(self):<br/>        self.face_status = &quot;SCANNING...&quot;<br/>        Clock.schedule_once(lambda dt: self.finish_face(), 1.5)<br/>    def finish_face(self):<br/>        self.face_status = &quot;ACCESS GRANTED&quot;<br/>        Clock.schedule_once(lambda dt: setattr(self.manager, &quot;current&quot;, &quot;home&quot;), .6)<br/><br/>class PinScreen(Screen):<br/>    message = StringProperty(&quot;&quot;)<br/>    ok = BooleanProperty(False)<br/>    def unlock(self, value):<br/>        if value == &quot;1234&quot;:<br/>            self.ok, self.message = True, &quot;PIN ACCEPTED&quot;<br/>            Clock.schedule_once(lambda dt: setattr(self.manager, &quot;current&quot;, &quot;home&quot;), .3)<br/>        else:<br/>            self.ok, self.message = False, &quot;WRONG PIN&quot;<br/><br/>class HomeScreen(Screen):<br/>    time_text = StringProperty(&quot;&quot;)<br/>    def on_enter(self):<br/>        self.update_clock()<br/>    def update_clock(self, *args):<br/>        self.time_text = datetime.now().strftime(&quot;%H:%M&quot;)<br/>        Clock.schedule_once(self.update_clock, 1)<br/>    def info(self, title, body):<br/>        s = self.manager.get_screen(&quot;info&quot;)<br/>        s.title_text, s.body_text = title, body<br/>        self.manager.current = &quot;info&quot;<br/><br/>class DrawerScreen(Screen):<br/>    pass<br/><br/>class GamingScreen(Screen):<br/>    fps = NumericProperty(90)<br/>    mode = StringProperty(&quot;Performance&quot;)<br/>    def set_mode(self, mode, fps):<br/>        self.mode, self.fps = mode, fps<br/><br/>class PanelScreen(Screen):<br/>    wifi = BooleanProperty(True)<br/>    bt = BooleanProperty(False)<br/>    air = BooleanProperty(False)<br/>    dnd = BooleanProperty(False)<br/>    brightness = NumericProperty(75)<br/>    volume = NumericProperty(60)<br/>    wifi_text = StringProperty(&quot;Wi-Fi ON&quot;)<br/>    bt_text = StringProperty(&quot;Bluetooth OFF&quot;)<br/>    air_text = StringProperty(&quot;Airplane OFF&quot;)<br/>    dnd_text = StringProperty(&quot;DND OFF&quot;)<br/>    def toggle(self, name):<br/>        setattr(self, name, not getattr(self, name))<br/>        self.wifi_text = &quot;Wi-Fi &quot; + (&quot;ON&quot; if self.wifi else &quot;OFF&quot;)<br/>        self.bt_text = &quot;Bluetooth &quot; + (&quot;ON&quot; if self.bt else &quot;OFF&quot;)<br/>        self.air_text = &quot;Airplane &quot; + (&quot;ON&quot; if self.air else &quot;OFF&quot;)<br/>        self.dnd_text = &quot;DND &quot; + (&quot;ON&quot; if self.dnd else &quot;OFF&quot;)<br/><br/>class SettingsScreen(Screen):<br/>    pass<br/><br/>class InfoScreen(Screen):<br/>    title_text = StringProperty(&quot;ABOUT&quot;)<br/>    body_text = StringProperty(&quot;AmanOS&quot;)<br/><br/>class NotificationsScreen(Screen):<br/>    pass<br/><br/>class AmanOSApp(App):<br/>    bg_color = StringProperty(&quot;#08090C&quot;)<br/>    card_color = StringProperty(&quot;#171A20&quot;)<br/>    text_color = StringProperty(&quot;#FFFFFF&quot;)<br/>    gray_color = StringProperty(&quot;#8C929D&quot;)<br/>    blue_color = StringProperty(&quot;#5B8CFF&quot;)<br/>    green_color = StringProperty(&quot;#55D187&quot;)<br/>    red_color = StringProperty(&quot;#FF5C6C&quot;)<br/><br/>    def build(self):<br/>        Builder.load_string(KV)<br/>        sm = Root()<br/>        screens = [<br/>            (LockScreen, &quot;lock&quot;), (PinScreen, &quot;pin&quot;), (HomeScreen, &quot;home&quot;),<br/>            (DrawerScreen, &quot;drawer&quot;), (GamingScreen, &quot;gaming&quot;),<br/>            (PanelScreen, &quot;panel&quot;), (SettingsScreen, &quot;settings&quot;),<br/>            (InfoScreen, &quot;info&quot;), (NotificationsScreen, &quot;notifications&quot;)<br/>        ]<br/>        for cls, name in screens:<br/>            sm.add_widget(cls(name=name))<br/>        sm.current = &quot;lock&quot;<br/>        return sm<br/><br/>    def set_theme(self, light):<br/>        if light:<br/>            self.bg_color=&quot;#F3F4F7&quot;; self.card_color=&quot;#E7E9EF&quot;<br/>            self.text_color=&quot;#111318&quot;; self.gray_color=&quot;#606773&quot;<br/>            self.blue_color=&quot;#4E7FF2&quot;; self.green_color=&quot;#239B55&quot;; self.red_color=&quot;#D83A4B&quot;<br/>        else:<br/>            self.bg_color=&quot;#08090C&quot;; self.card_color=&quot;#171A20&quot;<br/>            self.text_color=&quot;#FFFFFF&quot;; self.gray_color=&quot;#8C929D&quot;<br/>            self.blue_color=&quot;#5B8CFF&quot;; self.green_color=&quot;#55D187&quot;; self.red_color=&quot;#FF5C6C&quot;<br/><br/>if __name__ == &quot;__main__&quot;:<br/>    AmanOSApp().run()<br/></body>
</html>